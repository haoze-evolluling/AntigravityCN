# ==========================================
# AntigravityCN - Git 忽略规则配置
# ==========================================

# ------------------------------------------
# 1. 编译构建产物 (Build Outputs)
# ------------------------------------------
# Wails 默认构建输出目录
/build/bin/

# 通用构建输出目录
/bin/
/dist/
/out/

# 二进制可执行文件与动态链接库
*.exe
*.exe~
*.dll
*.so
*.dylib

# ------------------------------------------
# 2. 前端依赖与临时缓存 (Frontend & Node.js)
# ------------------------------------------
# 依赖包目录
node_modules/
LearningObjects/

# 前端构建产物 (由 Wails 打包集成)
/frontend/dist/

# 构建脚本依赖哈希校验临时文件
/frontend/package.json.md5

# 本地环境变量配置文件
.env.local
.env.*.local

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# 3. 语言与测试临时文件 (Go & Testing)
# ------------------------------------------
*.test
*.out
*.prof

# ------------------------------------------
# 4. 编辑器与开发工具 (IDEs & Dev Tools)
# ------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code (保留工作区推荐配置，仅忽略本地个人配置)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ------------------------------------------
# 5. 操作系统临时文件与通用日志 (OS & Logs)
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# 日志与临时备份文件
*.log
*.tmp
*.temp
*.bak
*.swp
*~